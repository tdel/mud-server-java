    <npc id="d7df2469-1f0a-409d-978b-8eaf4b635ca8">
        <name>Warehouse Keeper</name>
        <title>Warehouse Keeper</title>
        <type>WAREHOUSE_KEEPER</type>
        <gender>MAN</gender>
        <dialogue>
            <greeting>Grain, wool, iron... the whole of Floran passes through my warehouse.</greeting>
            <options>
                <label>Can I store my belongings here?</label>
                <type>RESPONSE</type>
                <response>The guild only takes merchants' goods for now. Ask again when the new vaults are open.</response>
            </options>
            <options>
                <label>Goodbye</label>
                <type>LEAVE</type>
            </options>
        </dialogue>
        <level>70</level>
    </npc>
    <npc id="924e30ad-82f3-4c4f-8d1b-01b3b49028b7">
        <name>Farmer</name>
        <title>Floran Farmer</title>
        <gender>WOMAN</gender>
        <dialogue>
            <greeting>Good day! The fields of Floran feed half the kingdom, you know.</greeting>
            <options>
                <label>Any trouble around here?</label>
                <type>RESPONSE</type>
                <response>Only the stakatos. They come down from Cruma at night and chew through the fences.</response>
            </options>
            <options>
                <label>Goodbye</label>
                <type>LEAVE</type>
            </options>
        </dialogue>
        <level>1</level>
    </npc>

    <!-- ===== Gludio Castle : garnison du château (zone de siège, sans zone de paix) ===== -->
    <npc id="bfe9bed7-4db0-4f01-9036-08a666866b0e">
        <name>Chamberlain</name>
        <title>Chamberlain of Gludio</title>
        <type>CHAMBERLAIN</type>
        <gender>MAN</gender>
        <dialogue>
            <greeting>The castle belongs to the lord of Gludio... until a clan takes it from him. What is your business here?</greeting>
            <options>
                <label>How can a clan take the castle?</label>
                <type>RESPONSE</type>
                <response>By siege, as it has always been. Break the gate, hold the keep, and the crown of Gludio is yours. No law protects you inside these walls.</response>
            </options>
            <options>
                <label>Goodbye</label>
                <type>LEAVE</type>
            </options>
        </dialogue>
        <level>70</level>
    </npc>
