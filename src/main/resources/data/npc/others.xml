    <npc id="a4970e86-708e-4dd8-87b4-fd679a9d4051">
        <name>Priest</name>
        <title>Priest of Einhasad</title>
        <type>PRIEST</type>
        <gender>WOMAN</gender>
        <dialogue>
            <greeting>Rest a while in the chapel. The road through the marsh is long.</greeting>
            <options>
                <label>Tell me about this chapel.</label>
                <type>RESPONSE</type>
                <response>It was raised by the farmers of Floran, in thanks for a harvest saved from the locusts. Einhasad has watched over Dion ever since.</response>
            </options>
            <options>
                <label>Goodbye</label>
                <type>LEAVE</type>
            </options>
        </dialogue>
        <level>70</level>
    </npc>
    <npc id="30a00cb4-dd8f-42a3-ba2f-c02a86dd181e">
        <name>Gatekeeper</name>
