    <npc id="fafba5b9-40b3-40fb-8660-506ba3373506">
        <name>Mercenary Captain</name>
        <title>Mercenary Manager</title>
        <type>GUARD</type>
        <gender>MAN</gender>
        <dialogue>
            <greeting>Looking for work? The castle always needs swords before a siege.</greeting>
            <options>
                <label>When is the next siege?</label>
                <type>RESPONSE</type>
                <response>When a clan dares to declare it. Until then, my men drill in the barracks and wait.</response>
            </options>
            <options>
                <label>Goodbye</label>
                <type>LEAVE</type>
            </options>
        </dialogue>
        <level>40</level>
